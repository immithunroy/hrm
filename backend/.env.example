# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zkt_payroll?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ZKT F22 Device Configuration
ZKT_DEVICE_IP=192.168.31.5
ZKT_DEVICE_PORT=4370
ZKT_DEVICE_TIMEOUT=5000
ZKT_DEVICE_USERNAME=
ZKT_DEVICE_PASSWD=

# CORS
CORS_ORIGIN=http://localhost:5173

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# Pusher (for real-time updates - optional)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=